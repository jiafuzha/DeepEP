+/* Multi-QP AFFINITY selection (design-(b) subgroup-cooperative path).
+ *
+ * Deterministically maps a caller-supplied affinity id (e.g. the producing
+ * sub-group's global id) to a fixed QP for this PE.  Unlike the round-robin
+ * _rr selector, this keeps EVERY put from one ordered unit (a producer's
+ * payload stream + its completion flag) on the SAME RC QP, so in-order NIC
+ * delivery still guarantees "payload visible before flag".  Different
+ * producers hash to different QPs and run in parallel — this is what lets the
+ * cooperative publish (which serialises SND_DBR per QP) scale: racers-per-QP =
+ * producing-subgroups / num_qps_per_pe.  See ishmemi_ibgda_device_post_put_nbi_sub_group. */
+ISHMEM_DEVICE_ATTRIBUTES inline ishmemi_ibgda_peer_context_t *
+ishmemi_ibgda_device_peer_context_sg(ishmemi_ibgda_device_context_t *ctx, int pe,
+                                     uint32_t affinity_id)
+{
+#ifdef __SYCL_DEVICE_ONLY__
+    if (ctx == nullptr) return nullptr;
+    if ((pe < 0) || (static_cast<uint32_t>(pe) >= ctx->n_pes)) return nullptr;
+    uint32_t qp = (ctx->num_qps_per_pe <= 1u) ? 0u
+                                              : (affinity_id & (ctx->num_qps_per_pe - 1u));
+    return &ctx->peers[static_cast<uint32_t>(pe) * ctx->num_qps_per_pe + qp];
+#else
+    (void) pe; (void) affinity_id;
+    return nullptr;
+#endif
+}
+
 ISHMEM_DEVICE_ATTRIBUTES inline bool ishmemi_ibgda_device_emit_staged_wqe(uint32_t opcode,
                                                                            const void *local_addr,
                                                                            const void *remote_addr,
@@ -1678,6 +1704,213 @@ ISHMEM_DEVICE_ATTRIBUTES inline bool ishmemi_ibgda_device_post_get(void *dst, co
 #endif
 }
 
+/* ============================================================================
+ * Design (b): sub-group-cooperative aggregated WQE publish.
+ *
+ * Root cause it fixes: the scalar emit path has every producing work-item
+ * independently fetch_add its own SQ slot, write its WQE body, then write
+ * SND_DBR + ring the UAR with NO ordering vs. other producers.  The NIC treats
+ * SND_DBR as the authoritative producer index and DMA-fetches every WQE below
+ * it — so it can fetch a WQE whose body a sibling producer has not finished
+ * writing -> garbage rkey/addr -> illegal RDMA -> QP error -> DEVICE_LOST.
+ *
+ * The cooperative path makes ONE leader per (sub-group, QP) publish on behalf
+ * of all its lanes:
+ *   1. partition the sub-group by key = (pe, qp)  [lanes may target different PEs]
+ *   2. per key: leader does ONE aggregated fetch_add(total_chunks) -> base
+ *   3. every lane writes its own chunks' WQE bodies into distinct slots
+ *      [base+off, base+off+my_chunks)  (fully parallel, no shared slot)
+ *   4. sub-group barrier
+ *   5. leader publishes SND_DBR = base+total ONCE and rings the UAR ONCE,
+ *      gated by nic_wq_commit so SND_DBR stays MONOTONIC across the sub-groups
+ *      sharing this QP.
+ *
+ * Two properties make this SIMD-safe on Intel EU threads (unlike the removed
+ * post-loop spin protocol):
+ *   - A sub-group is ONE EU thread.  All lanes' WQE-body stores therefore come
+ *     from a single hardware thread, so the leader's system-release fence in
+ *     ring_doorbell orders ALL of them (its own and its mates') before SND_DBR
+ *     becomes externally visible to the NIC.
+ *   - The only spin (the commit gate) waits on an EXTERNAL cross-sub-group
+ *     counter, never on a sibling lane, so there is no intra-sub-group mutual
+ *     wait -> no reconvergence deadlock.
+ *
+ * INTEGRATION CONTRACT: for a QP driven by this path, ALL producers to that QP
+ * must go through this path (they all advance nic_wq_commit).  Mixing scalar
+ * post_put_nbi emits on the same QP would break the commit gate.  DeepEP LL
+ * routes its dispatch/combine payload+flag puts here on affinity QPs.
+ *
+ * OCCUPANCY CAVEAT: the commit gate assumes the sub-group holding
+ * commit==base is resident and will publish.  Confine a QP's producers to
+ * co-resident work-groups (or one work-group) — a grid-wide set of producers
+ * where some are not resident can starve the gate.
+ * ========================================================================== */
+
+/* Forward decl: the cooperative fallback path calls the scalar put, defined below. */
+ISHMEM_DEVICE_ATTRIBUTES inline bool ishmemi_ibgda_device_post_put_nbi(const void *src, void *dst,
+                                                                       size_t nbytes, int pe);
+
+/* Write a single mlx5 RDMA WQE body at a given SQ slot.  Does NOT fetch_add and
+ * does NOT touch the doorbell — publish is the caller's (leader's) job.  Body
+ * layout mirrors emit_direct_wqe_skeleton (32-bit-split addr math: Xe2 SIMD16
+ * 64-bit codegen bug). */
+ISHMEM_DEVICE_ATTRIBUTES inline void ishmemi_ibgda_device_write_wqe_body(
+    ishmemi_ibgda_device_context_t *ctx,
+    ishmemi_ibgda_peer_context_t *peer_ctx,
+    uint32_t opcode, uint32_t wqe_idx,
+    const void *local_addr, const void *remote_addr, size_t nbytes)
+{
+#ifdef __SYCL_DEVICE_ONLY__
+    const uint32_t num_wqebb = peer_ctx->nic_wq_slots;
+    volatile uint32_t *wqe = reinterpret_cast<volatile uint32_t *>(
+        peer_ctx->nic_wq_base_addr +
+        (static_cast<size_t>(wqe_idx & (num_wqebb - 1)) << 6));
+
+    const uint32_t nic_opcode = (opcode == ISHMEMI_IBGDA_WQE_OP_PUT) ? 0x8u : 0x10u;
+    constexpr uint32_t ds = 3u;
+
+    uint32_t remote_offset = static_cast<uint32_t>(
+        reinterpret_cast<uintptr_t>(remote_addr) - ctx->heap_base);
+    uint32_t rv_lo = static_cast<uint32_t>(peer_ctx->remote_vaddr & 0xFFFFFFFFu);
+    uint32_t rv_hi = static_cast<uint32_t>(peer_ctx->remote_vaddr >> 32u);
+    uint32_t raddr_lo = rv_lo + remote_offset;
+    uint32_t raddr_hi = rv_hi + ((raddr_lo < rv_lo) ? 1u : 0u);
+
+    uint32_t la_lo = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(local_addr) & 0xFFFFFFFFu);
+    uint32_t la_hi = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(local_addr) >> 32u);
+
+    uint32_t wqe_ctr16 = (wqe_idx & 0xFFFFu);
+    wqe[0] = ishmemi_ibgda_htobe32((wqe_ctr16 << 8u) | nic_opcode);
+    wqe[1] = ishmemi_ibgda_htobe32(((peer_ctx->sq_num & 0xFFFFFFu) << 8u) | ds);
+    wqe[2] = ishmemi_ibgda_htobe32(0x08u); /* fm_ce_se: CQE on completion */
+    wqe[3] = 0;
+    wqe[4] = ishmemi_ibgda_htobe32(raddr_hi);
+    wqe[5] = ishmemi_ibgda_htobe32(raddr_lo);
+    wqe[6] = peer_ctx->rkey_be;
+    wqe[7] = 0;
+    wqe[8]  = ishmemi_ibgda_htobe32(static_cast<uint32_t>(nbytes));
+    wqe[9]  = peer_ctx->lkey_be;
+    wqe[10] = ishmemi_ibgda_htobe32(la_hi);
+    wqe[11] = ishmemi_ibgda_htobe32(la_lo);
+    wqe[12] = 0; wqe[13] = 0; wqe[14] = 0; wqe[15] = 0;
+#else
+    (void) ctx; (void) peer_ctx; (void) opcode; (void) wqe_idx;
+    (void) local_addr; (void) remote_addr; (void) nbytes;
+#endif
+}
+
+/* Cooperative NBI put.  ALL lanes of the sub-group must call this convergently;
+ * a lane with no work passes active=false (its src/dst/nbytes are ignored).
+ * affinity_id selects the QP (keep the same value for a producer's payload and
+ * its flag so they stay on one ordered QP).  Returns true on the emit path. */
+ISHMEM_DEVICE_ATTRIBUTES inline bool ishmemi_ibgda_device_post_put_nbi_sub_group(
+    const void *src, void *dst, size_t nbytes, int pe, bool active,
+    uint32_t affinity_id, const sycl::sub_group &sg)
+{
+#ifdef __SYCL_DEVICE_ONLY__
+    ishmemi_ibgda_device_context_t *ctx = ishmemi_ibgda_device_get_context();
+    if (ctx == nullptr) return false;
+
+    const bool can_direct = ishmemi_ibgda_device_can_direct_doorbell(ctx);
+    /* mlx5 direct-doorbell only in the cooperative path (bnxt uses scalar). */
+    if (!can_direct || ctx->nic_vendor == ISHMEMI_IBGDA_NIC_VENDOR_BNXT) {
+        /* Fallback: each active lane uses the proven scalar path. */
+        if (active && nbytes > 0)
+            return ishmemi_ibgda_device_post_put_nbi(src, dst, nbytes, pe);
+        return true;
+    }
+
+    constexpr size_t chunk_size = ISHMEMI_IBGDA_NBI_PUT_CHUNK_SIZE;
+    const uint32_t nqp = ctx->num_qps_per_pe;
+    uint32_t qp_idx = (nqp <= 1u) ? 0u : (affinity_id & (nqp - 1u));
+
+    /* Per-lane key + chunk count. */
+    bool     lane_active = active && (nbytes > 0);
+    uint32_t my_chunks   = lane_active
+        ? static_cast<uint32_t>((nbytes + chunk_size - 1) / chunk_size) : 0u;
+    if (my_chunks == 0u) lane_active = false;
+    int      key = lane_active ? (pe * static_cast<int>(nqp) + static_cast<int>(qp_idx)) : -1;
+
+    const uint32_t lane = sg.get_local_id()[0];
+    const uint32_t sz   = sg.get_local_range()[0];
+
+    bool todo = lane_active;
+    for (uint32_t iter = 0; iter < sz; ++iter) {
+        uint32_t any = sycl::reduce_over_group(sg, todo ? 1u : 0u, sycl::plus<uint32_t>());
+        if (any == 0u) break;
+
+        uint32_t rep = sycl::reduce_over_group(sg, todo ? lane : sz, sycl::minimum<uint32_t>());
+        int      k    = sycl::group_broadcast(sg, key, rep);
+        int      pe_k = sycl::group_broadcast(sg, pe,  rep);
+        uint32_t qp_k = sycl::group_broadcast(sg, qp_idx, rep);
+        ishmemi_ibgda_peer_context_t *peer_ctx =
+            ishmemi_ibgda_device_peer_context_qp(ctx, pe_k, qp_k);
+
+        bool same = todo && (key == k);
+        uint32_t cnt_lane = same ? my_chunks : 0u;
+        uint32_t off      = sycl::exclusive_scan_over_group(sg, cnt_lane, sycl::plus<uint32_t>());
+        uint32_t total_c  = sycl::reduce_over_group(sg, cnt_lane, sycl::plus<uint32_t>());
+        uint32_t leader_lane = sycl::reduce_over_group(sg, same ? lane : sz, sycl::minimum<uint32_t>());
+        bool leader = same && (lane == leader_lane);
+
+        uint32_t base = 0u;
+        if (leader && total_c > 0u && peer_ctx != nullptr) {
+            sycl::atomic_ref<uint32_t, sycl::memory_order::relaxed, sycl::memory_scope::device,
+                             sycl::access::address_space::global_space>
+                a(*reinterpret_cast<uint32_t *>(peer_ctx->nic_wq_cnt_addr));
+            base = a.fetch_add(total_c);
+        }
+        base = sycl::group_broadcast(sg, base, leader_lane);
+
+        /* Each same-key lane writes its own chunks' WQE bodies (distinct slots). */
+        if (same && peer_ctx != nullptr) {
+            size_t   offset = 0;
+            uint32_t widx   = base + off;
+            for (uint32_t c = 0; c < my_chunks; ++c) {
+                size_t this_chunk = nbytes - offset;
+                if (this_chunk > chunk_size) this_chunk = chunk_size;
+                const void *cl = reinterpret_cast<const void *>(
+                    reinterpret_cast<uintptr_t>(src) + offset);
+                void *cr = reinterpret_cast<void *>(
+                    reinterpret_cast<uintptr_t>(dst) + offset);
+                ishmemi_ibgda_device_write_wqe_body(ctx, peer_ctx, ISHMEMI_IBGDA_WQE_OP_PUT,
+                                                    widx, cl, cr, this_chunk);
+                offset += this_chunk;
+                ++widx;
+            }
+        }
+
+        sycl::group_barrier(sg);   /* all WQE bodies written before publish */
+
+        if (leader && total_c > 0u && peer_ctx != nullptr) {
+            uint32_t new_prod = base + total_c;
+            /* Commit gate: publish in claim order -> SND_DBR monotonic per QP.
+             * Waits on a cross-sub-group counter (distinct EU threads), never a
+             * sibling lane. */
+            sycl::atomic_ref<uint32_t, sycl::memory_order::acq_rel, sycl::memory_scope::device,
+                             sycl::access::address_space::global_space>
+                commit(*reinterpret_cast<uint32_t *>(peer_ctx->nic_wq_commit_addr));
+            while (commit.load(sycl::memory_order::acquire) != base) { /* spin */ }
+
+            const uint32_t num_wqebb = peer_ctx->nic_wq_slots;
+            volatile uint32_t *last_wqe = reinterpret_cast<volatile uint32_t *>(
+                peer_ctx->nic_wq_base_addr +
+                (static_cast<size_t>((new_prod - 1u) & (num_wqebb - 1)) << 6));
+            ishmemi_ibgda_device_ring_doorbell(peer_ctx, last_wqe, new_prod);
+
+            commit.store(new_prod, sycl::memory_order::release);  /* release next leader */
+        }
+
+        todo = same ? false : todo;   /* retire handled lanes */
+    }
+    return true;
+#else
+    (void) src; (void) dst; (void) nbytes; (void) pe; (void) active;
+    (void) affinity_id; (void) sg;
+    return false;
+#endif
+}
+
 ISHMEM_DEVICE_ATTRIBUTES inline bool ishmemi_ibgda_device_post_put_nbi(const void *src, void *dst,
                                                                        size_t nbytes, int pe)
 {

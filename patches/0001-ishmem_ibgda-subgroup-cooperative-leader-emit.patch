+++ b/src/nbi.cpp
@@ -64,6 +64,21 @@ void ishmemx_putmem_nbi_work_group(void *dest, const void *src, size_t nelems, i
     ishmemx_internal_put_nbi_work_group((uint8_t *) dest, (uint8_t *) src, nelems, pe, grp);
 }
 
+/* Cooperative NBI put (design-(b) sub-group aggregated publish). Thin export
+ * over the device emit; see ibgda_device_impl.h for the algorithm/contract. */
+void ishmemx_putmem_nbi_sub_group(void *dest, const void *src, size_t nbytes, int pe, bool active,
+                                  unsigned int affinity_id, const sycl::sub_group &grp)
+{
+#ifdef __SYCL_DEVICE_ONLY__
+    (void) ishmemi_ibgda_device_post_put_nbi_sub_group(src, dest, nbytes, pe, active,
+                                                       affinity_id, grp);
+#else
+    (void) dest; (void) src; (void) nbytes; (void) pe;
+    (void) active; (void) affinity_id; (void) grp;
+    RAISE_ERROR_MSG("ISHMEMX_PUTMEM_NBI_SUB_GROUP is not callable from host\n");
+#endif
+}
+
 /* clang-format off */
 #define ISHMEMI_API_IMPL_PUT_NBI(TYPENAME, TYPE)                                                                                                                  \
     ISHMEM_INSTANTIATE_TYPE_##TYPENAME(TYPE);                                                                                                                     \
diff --git a/test/unit/ibgda_doorbell_stress.cpp b/test/unit/ibgda_doorbell_stress.cpp
new file mode 100644
index 00000000..082f82fc
--- /dev/null
+++ b/test/unit/ibgda_doorbell_stress.cpp
@@ -0,0 +1,189 @@
+/* Copyright (C) 2026 Intel Corporation
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * ibgda_doorbell_stress.cpp
+ *
+ * Stress variant of ibgda_doorbell_proof.cpp.  Same faithful iSHMEM DEVX QP +
+ * GPU-VRAM SQ/DBR + igub-mapped UAR path (exactly what DeepEP exercises), but
+ * adds the two dimensions that the single-work-item proof test does NOT cover
+ * and that the identified LL root cause depends on:
+ *
+ *   1. CONCURRENT PRODUCERS.  DeepEP LL dispatch/combine issues RDMA puts from
+ *      MANY concurrent work-items; with ISHMEM_IBGDA_QPS_PER_PE=1 they all post
+ *      to the SAME peer QP and ring the SAME UAR doorbell.  This is where the
+ *      concurrent-producer doorbell race lives (a higher-index producer can
+ *      advance snd_dbr + ring the UAR before a lower-index producer published
+ *      its WQE -> NIC fetches a stale WQE -> illegal RDMA / DEVICE_LOST).
+ *   2. SCALE.  Larger N_PUTS / element counts / repeated kernels, to drive the
+ *      intermittent failure toward determinism (the whole point of the sweep).
+ *
+ * Env knobs (all optional):
+ *   ISHMEM_PROOF_NPUTS      total puts issued per kernel   (default 64)
+ *   ISHMEM_PROOF_ELEMS      ints per put                   (default 1)
+ *   ISHMEM_PROOF_WORKITEMS  concurrent work-items          (default 1 = serial)
+ *   ISHMEM_PROOF_KITERS     kernel repetitions             (default 1)
+ *
+ * Pass criteria (per PE, per final kernel):
+ *   - flags == 0x3f (direct-doorbell armed)
+ *   - stats_doorbell_writes advanced (GPU rang the UAR)
+ *   - dst[] holds the expected pattern from prev_pe (data delivered)
+ *
+ * Exit codes: 0 pass; 1 data-mismatch; 2 no doorbell advance; 3 not armed.
+ */
+
+#include <common.h>
+#include "ibgda.h"
+#include "ibgda_types.h"
+
+static int env_int(const char *name, int dflt)
+{
+    const char *v = getenv(name);
+    if (!v || !v[0]) return dflt;
+    int x = std::atoi(v);
+    return (x > 0) ? x : dflt;
+}
+
+int main(int /*argc*/, char ** /*argv*/)
+{
+    ishmem_init();
+    sycl::queue q;
+
+    const int my_pe = ishmem_my_pe();
+    const int npes  = ishmem_n_pes();
+
+    if (npes < 2) {
+        std::cout << "[PE " << my_pe << "] SKIP: need >= 2 PEs\n";
+        ishmem_finalize();
+        return 0;
+    }
+    const int next_pe = (my_pe + 1) % npes;
+    const int prev_pe = (my_pe + npes - 1) % npes;
+
+    const int N_PUTS    = env_int("ISHMEM_PROOF_NPUTS", 64);
+    const int ELEMS     = env_int("ISHMEM_PROOF_ELEMS", 1);
+    const int WORKITEMS = std::min(env_int("ISHMEM_PROOF_WORKITEMS", 1), N_PUTS);
+    const int KITERS    = env_int("ISHMEM_PROOF_KITERS", 1);
+    const int VEC       = N_PUTS * ELEMS;
+
+    if (my_pe == 0) {
+        std::cout << "[stress] N_PUTS=" << N_PUTS << " ELEMS=" << ELEMS
+                  << " WORKITEMS=" << WORKITEMS << " KITERS=" << KITERS << "\n";
+    }
+
+    ishmemi_ibgda_device_context_t *dctx = ishmemi_ibgda_device_context();
+    if (dctx == nullptr) {
+        std::cerr << "[PE " << my_pe << "] FAIL: ibgda_device_context()==nullptr\n";
+        ishmem_finalize();
+        return 3;
+    }
+
+    const uint32_t flags_before = dctx->flags;
+    const int direct_path_armed = (flags_before == 0x3f) ? 1 : 0;
+    std::cout << "[PE " << my_pe << "] flags=0x" << std::hex << flags_before
+              << std::dec << " (expected 0x3f)\n";
+
+    int *src = static_cast<int *>(ishmem_malloc(VEC * sizeof(int)));
+    int *dst = static_cast<int *>(ishmem_malloc(VEC * sizeof(int)));
+    CHECK_ALLOC(src);
+    CHECK_ALLOC(dst);
+
+    uint64_t dbs_before = dctx->stats_doorbell_writes;
+    int final_errors = 0;
+
+    for (int k = 0; k < KITERS; ++k) {
+        /* init src (my sentinel) + clear dst */
+        q.submit([&](sycl::handler &h) {
+             h.single_task([=]() {
+                 for (int i = 0; i < VEC; ++i) {
+                     src[i] = (my_pe << 20) | (k << 16) | (i & 0xFFFF);
+                     dst[i] = -1;
+                 }
+             });
+         }).wait_and_throw();
+        ishmem_barrier_all();
+
+        if (WORKITEMS <= 1) {
+            /* serial megakernel (identical to proof test) */
+            q.submit([&](sycl::handler &h) {
+                 h.single_task([=]() {
+                     for (int i = 0; i < N_PUTS; ++i)
+                         ishmem_int_put_nbi(&dst[i * ELEMS], &src[i * ELEMS],
+                                            ELEMS, next_pe);
+                     ishmem_quiet();
+                 });
+             }).wait_and_throw();
+        } else {
+            /* CONCURRENT producers: WORKITEMS work-items each issue a strided
+             * subset of the N_PUTS to the SAME next_pe (same QP). This is the
+             * concurrent-producer doorbell-race path. */
+            const int W = WORKITEMS;
+            q.submit([&](sycl::handler &h) {
+                 h.parallel_for(sycl::range<1>(W), [=](sycl::id<1> idx) {
+                     const int w = static_cast<int>(idx[0]);
+                     for (int i = w; i < N_PUTS; i += W)
+                         ishmem_int_put_nbi(&dst[i * ELEMS], &src[i * ELEMS],
+                                            ELEMS, next_pe);
+                 });
+             }).wait_and_throw();
+            /* single-work-item quiet to flush all outstanding puts */
+            q.submit([&](sycl::handler &h) {
+                 h.single_task([=]() { ishmem_quiet(); });
+             }).wait_and_throw();
+        }
+
+        ishmem_barrier_all();
+
+        /* validate this iteration's delivery */
+        int *dst_h = sycl::malloc_host<int>(VEC, q);
+        CHECK_ALLOC(dst_h);
+        q.memcpy(dst_h, dst, VEC * sizeof(int)).wait();
+        int n_errors = 0;
+        for (int i = 0; i < N_PUTS; ++i) {
+            for (int e = 0; e < ELEMS; ++e) {
+                const int off = i * ELEMS + e;
+                const int expect = (prev_pe << 20) | (k << 16) | (off & 0xFFFF);
+                if (dst_h[off] != expect) {
+                    if (n_errors < 4)
+                        std::cerr << "[PE " << my_pe << "] k=" << k << " dst["
+                                  << off << "]=0x" << std::hex << dst_h[off]
+                                  << " expect=0x" << expect << std::dec << "\n";
+                    ++n_errors;
+                }
+            }
+        }
+        sycl::free(dst_h, q);
+        final_errors += n_errors;
+        if (n_errors)
+            std::cerr << "[PE " << my_pe << "] k=" << k << " data errors="
+                      << n_errors << "/" << VEC << "\n";
+    }
+
+    const uint64_t dbs_delta = dctx->stats_doorbell_writes - dbs_before;
+    std::cout << "[PE " << my_pe << "] doorbells_delta=" << dbs_delta
+              << " (expected >= " << (uint64_t) N_PUTS * KITERS << ")\n";
+
+    int exit_code = 0;
+    if (!direct_path_armed) {
+        std::cerr << "[PE " << my_pe << "] FAIL(3): flags != 0x3f\n";
+        exit_code = 3;
+    } else if (dbs_delta < (uint64_t) N_PUTS * KITERS) {
+        std::cerr << "[PE " << my_pe << "] FAIL(2): doorbells_delta=" << dbs_delta
+                  << " < " << (uint64_t) N_PUTS * KITERS << "\n";
+        exit_code = 2;
+    } else if (final_errors != 0) {
+        std::cerr << "[PE " << my_pe << "] FAIL(1): " << final_errors
+                  << " total data errors across " << KITERS << " kernels\n";
+        exit_code = 1;
+    } else {
+        std::cout << "[PE " << my_pe << "] PASS: flags=0x3f, " << dbs_delta
+                  << " doorbells, all data delivered across " << KITERS
+                  << " kernels\n";
+    }
+
+    fflush(stdout);
+    fflush(stderr);
+    ishmem_free(src);
+    ishmem_free(dst);
+    ishmem_finalize();
+    return exit_code;
+}
diff --git a/test/unit/oom_copy_engine_probe.cpp b/test/unit/oom_copy_engine_probe.cpp
new file mode 100644
index 00000000..981a6786
--- /dev/null
+++ b/test/unit/oom_copy_engine_probe.cpp
@@ -0,0 +1,321 @@
+/* Copyright (C) 2026 Intel Corporation
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * oom_copy_engine_probe.cpp
+ *
+ * STANDALONE iSHMEM-ONLY reproducer for the residual DeepEP-LL mid-test
+ * failure that surfaces as
+ *     RuntimeError: level_zero backend failed with error:
+ *                   39 (UR_RESULT_ERROR_OUT_OF_DEVICE_MEMORY)
+ * inside buffer.low_latency_dispatch, even though the GPU has ~22.7 GiB free.
+ *
+ * Root-cause characterization (from the DeepEP investigation) that this UT
+ * tries to reproduce with iSHMEM alone (NO DeepEP, NO torch, NO python):
+ *   - The OOM is on the SMALL OUTPUT/scratch device allocations that
+ *     low_latency_dispatch makes with torch::empty (a few MB) BEFORE it
+ *     launches the IBGDA put kernel -> i.e. it is PRE-DOORBELL
+ *     (stats_post_put_nbi_calls==0, stats_doorbell_writes==0 at failure).
+ *   - dmesg at failure shows only benign copy-engine (bcs) resets +
+ *     "VM worker error: -16" (EBUSY); no ccs wedge, no lr_cleanup, no GT reset.
+ *   - It is a transiently-wedged copy(bcs) engine causing the L0 driver to
+ *     MISREPORT OOM for the first device-touch allocation.
+ *
+ * Reproduction strategy (mimics the LL-dispatch memory/engine pattern):
+ *   init IBGDA (igub UAR) + symmetric heap exactly like the LL path, then loop
+ *   ITERS times.  Each iteration reproduces one dispatch "shape":
+ *     1. (optional, DO_DOORBELL) comm-queue kernel that issues PUTS_PER_ITER
+ *        ishmem_int_put_nbi to the ring-next PE + in-kernel ishmem_quiet
+ *        (this is the doorbell/UAR + NIC activity DeepEP does), then a barrier.
+ *        With DO_DOORBELL=0 the put kernel is skipped so we prove the OOM is
+ *        PRE-doorbell (the failing alloc happens before any put in the real bug).
+ *     2. free the previous iteration's device allocations (allocator churn).
+ *     3. allocate a batch of NUM_ALLOCS SMALL sycl::malloc_device buffers
+ *        (ALLOC_BYTES each, default 256 KiB) on the SAME device/context and
+ *        CHECK EACH for OOM (sycl::exception errc::memory_allocation / UR 39 /
+ *        nullptr).  These stand in for packed_recv_x / scales / counts.
+ *     4. copy-engine (bcs) pressure: memset + a tiny compute kernel that writes
+ *        each buffer, then a D2H memcpy of a scalar back to host (== the
+ *        recv_count.item() D2H that first observes the wedge), plus H2D churn.
+ *   At the moment of any OOM we print: iteration, alloc index, FREE/TOTAL
+ *   device memory (proving memory was actually free), and the IBGDA stats
+ *   (post_put_nbi_calls / doorbell_writes / flags) proving pre-doorbell timing.
+ *
+ * NO ishmem_finalize() (matches DeepEP), so teardown effects are excluded.
+ *
+ * Controls (env vars):
+ *   ITERS          number of dispatch-shaped iterations           (default 50)
+ *   NUM_ALLOCS     small device allocs per iteration               (default 24)
+ *   ALLOC_BYTES    bytes per small device alloc                    (default 262144)
+ *   PUTS_PER_ITER  ishmem_int_put_nbi per comm kernel              (default 64)
+ *   DO_DOORBELL    1=run put+quiet comm kernel; 0=pre-doorbell only(default 1)
+ *   COPY_PRESSURE  1=interleave H2D/D2H memcpy to stress bcs       (default 1)
+ *   D2H_ITERS      extra D2H scalar reads per iteration            (default 8)
+ *   STOP_ON_OOM    1=stop loop at first OOM; 0=keep going          (default 1)
+ *   HEARTBEAT      print free-mem line every N iters               (default 1)
+ *
+ * Exit codes:
+ *   0  completed all iterations with NO OOM (did not reproduce)
+ *   39 reproduced the OUT_OF_DEVICE_MEMORY (matches the level_zero err code)
+ *   2  a different fatal device error (e.g. DEVICE_LOST) was observed
+ */
+
+#include <common.h>
+#include "ibgda.h"
+#include "ibgda_types.h"
+
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static long env_long(const char *name, long dflt)
+{
+    const char *v = std::getenv(name);
+    if (v == nullptr || v[0] == '\0') return dflt;
+    return std::strtol(v, nullptr, 0);
+}
+
+/* Best-effort free-VRAM query.  Requires ZES_ENABLE_SYSMAN=1; returns 0 on
+ * failure so the caller can note it was unavailable. */
+static size_t query_free_mem(sycl::device &dev)
+{
+    try {
+        return dev.get_info<sycl::ext::intel::info::device::free_memory>();
+    } catch (...) {
+        return 0;
+    }
+}
+
+static bool is_oom_exception(const sycl::exception &e)
+{
+    if (e.code() == sycl::errc::memory_allocation) return true;
+    const std::string w = e.what();
+    return (w.find("OUT_OF_DEVICE_MEMORY") != std::string::npos) ||
+           (w.find("error: 39") != std::string::npos) ||
+           (w.find("error 39") != std::string::npos);
+}
+
+int main()
+{
+    sycl::queue q;
+    ishmem_init();
+
+    const int my_pe = ishmem_my_pe();
+    const int npes  = ishmem_n_pes();
+    const int next_pe = (my_pe + 1) % npes;
+
+    const long iters        = env_long("ITERS", 50);
+    const long num_allocs   = env_long("NUM_ALLOCS", 24);
+    const size_t alloc_bytes= (size_t) env_long("ALLOC_BYTES", 262144);
+    const long puts_per_iter= env_long("PUTS_PER_ITER", 64);
+    const int  do_doorbell  = (int) env_long("DO_DOORBELL", 1);
+    const int  copy_pressure= (int) env_long("COPY_PRESSURE", 1);
+    const long d2h_iters    = env_long("D2H_ITERS", 8);
+    const int  stop_on_oom  = (int) env_long("STOP_ON_OOM", 1);
+    const long heartbeat    = env_long("HEARTBEAT", 1);
+    const int  overlap      = (int) env_long("OVERLAP_KERNEL", 0);
+    const long overlap_spin = env_long("OVERLAP_SPIN", 2000000);
+    (void) stop_on_oom;
+
+    sycl::device dev = q.get_device();
+    /* Optional 2nd in-order queue on the SAME device -> dual-stream contention
+     * like DeepEP's comm_stream vs compute_stream (an in-flight compute kernel
+     * overlapping the alloc + blitter copy traffic). */
+    sycl::queue q2(dev, sycl::property::queue::in_order());
+    const size_t total_mem = dev.get_info<sycl::info::device::global_mem_size>();
+
+    ishmemi_ibgda_device_context_t *dctx = ishmemi_ibgda_device_context();
+    const uint32_t flags0 = dctx ? dctx->flags : 0xDEADu;
+
+    std::fprintf(stderr,
+        "[pe=%d/%d] START oom_copy_engine_probe dev=%s total=%.2f GiB free0=%.2f GiB\n"
+        "          iters=%ld num_allocs=%ld alloc_bytes=%zu puts/iter=%ld "
+        "do_doorbell=%d copy_pressure=%d d2h_iters=%ld ibgda_flags=0x%x\n",
+        my_pe, npes, dev.get_info<sycl::info::device::name>().c_str(),
+        total_mem / (1024.0 * 1024.0 * 1024.0),
+        query_free_mem(dev) / (1024.0 * 1024.0 * 1024.0),
+        iters, num_allocs, alloc_bytes, puts_per_iter, do_doorbell,
+        copy_pressure, d2h_iters, flags0);
+    std::fflush(stderr);
+
+    /* Symmetric buffers for the comm (put) activity -- like the LL RDMA buf. */
+    const size_t sym_elems = (size_t) (puts_per_iter > 0 ? puts_per_iter : 1);
+    int *src = (int *) ishmem_malloc(sym_elems * sizeof(int));
+    int *dst = (int *) ishmem_malloc(sym_elems * sizeof(int));
+    CHECK_ALLOC(src);
+    CHECK_ALLOC(dst);
+    q.single_task([=]() {
+         for (size_t i = 0; i < sym_elems; i++) { src[i] = (int) i; dst[i] = -1; }
+     }).wait_and_throw();
+    ishmem_barrier_all();
+
+    /* host staging buffer for D2H/H2D churn (pinned) */
+    const size_t host_elems = alloc_bytes / sizeof(int);
+    int *host_stage = sycl::malloc_host<int>(host_elems ? host_elems : 1, q);
+    CHECK_ALLOC(host_stage);
+
+    std::vector<void *> prev_batch;
+    int exit_code = 0;
+    bool reproduced = false;
+
+    for (long it = 0; it < iters && !reproduced; ++it) {
+        /* ---- 1. comm-queue kernel: puts + quiet (doorbell/UAR + NIC) ---- */
+        if (do_doorbell && puts_per_iter > 0) {
+            try {
+                q.single_task([=]() {
+                     for (long i = 0; i < puts_per_iter; ++i)
+                         ishmem_int_put_nbi(&dst[i], &src[i], 1, next_pe);
+                     ishmem_quiet();
+                 }).wait_and_throw();
+            } catch (sycl::exception const &e) {
+                std::fprintf(stderr, "[pe=%d] iter=%ld COMM_KERNEL_EXC: %s\n",
+                             my_pe, it, e.what());
+                std::fflush(stderr);
+                exit_code = is_oom_exception(e) ? 39 : 2;
+                reproduced = true;
+                break;
+            }
+            ishmem_barrier_all();
+        }
+
+        /* ---- 2. free previous iteration's allocations (churn) ---- */
+        for (void *p : prev_batch)
+            if (p) sycl::free(p, q);
+        prev_batch.clear();
+
+        /* ---- 2b. OPTIONAL dual-stream contention: launch a long compute
+         *      kernel on q2 (NOT waited) so it overlaps the alloc + blitter
+         *      copy traffic below, mirroring DeepEP comm/compute stream overlap
+         *      and maximizing the chance of a bcs/ccs engine wedge. ---- */
+        int *spin_buf = nullptr;
+        if (overlap) {
+            try {
+                spin_buf = (int *) sycl::malloc_device(4096, q2);
+                if (spin_buf) {
+                    q2.parallel_for(sycl::range<1>(1024), [=](sycl::id<1> gid) {
+                        volatile long acc = 0;
+                        for (long s = 0; s < overlap_spin; ++s) acc += (s ^ gid[0]) & 0xff;
+                        spin_buf[gid[0] % 1024] = (int) acc;
+                    });
+                }
+            } catch (...) { spin_buf = nullptr; }
+        }
+
+        /* ---- 3. batch of SMALL device allocations, checked for OOM ---- */
+        std::vector<void *> batch;
+        batch.reserve(num_allocs);
+        for (long a = 0; a < num_allocs; ++a) {
+            void *p = nullptr;
+            try {
+                p = sycl::malloc_device(alloc_bytes, q);
+            } catch (sycl::exception const &e) {
+                size_t freem = query_free_mem(dev);
+                std::fprintf(stderr,
+                    "\n[pe=%d] *** OOM/EXC at iter=%ld alloc=%ld ***\n"
+                    "        exc: %s\n"
+                    "        alloc_bytes=%zu  FREE=%.3f GiB / TOTAL=%.3f GiB "
+                    "(so memory was %s exhausted)\n"
+                    "        IBGDA: flags=0x%x post_put_nbi_calls=%llu "
+                    "doorbell_writes=%llu  => %s\n",
+                    my_pe, it, a, e.what(), alloc_bytes,
+                    freem / (1024.0 * 1024.0 * 1024.0),
+                    total_mem / (1024.0 * 1024.0 * 1024.0),
+                    (freem > (size_t) alloc_bytes * 64) ? "NOT" : "possibly",
+                    dctx ? dctx->flags : 0xDEADu,
+                    (unsigned long long) (dctx ? dctx->stats_post_put_nbi_calls : 0),
+                    (unsigned long long) (dctx ? dctx->stats_doorbell_writes : 0),
+                    (dctx && dctx->stats_doorbell_writes == 0)
+                        ? "PRE-DOORBELL (matches DeepEP bug)"
+                        : "post-doorbell");
+                std::fflush(stderr);
+                exit_code = is_oom_exception(e) ? 39 : 2;
+                reproduced = true;
+                break;
+            }
+            if (p == nullptr) {
+                size_t freem = query_free_mem(dev);
+                std::fprintf(stderr,
+                    "\n[pe=%d] *** malloc_device RETURNED NULL at iter=%ld "
+                    "alloc=%ld FREE=%.3f GiB ***\n",
+                    my_pe, it, a, freem / (1024.0 * 1024.0 * 1024.0));
+                std::fflush(stderr);
+                exit_code = 39;
+                reproduced = true;
+                break;
+            }
+            batch.push_back(p);
+        }
+        if (reproduced) {
+            for (void *p : batch) if (p) sycl::free(p, q);
+            break;
+        }
+
+        /* ---- 4. copy-engine (bcs) pressure on the fresh allocations ---- */
+        try {
+            for (void *p : batch) {
+                /* memset the "output" (compute/copy engine) */
+                q.memset(p, 0, alloc_bytes);
+                if (copy_pressure) {
+                    /* H2D then D2H forces the blitter (bcs) copy engine */
+                    q.memcpy(p, host_stage, alloc_bytes);
+                    q.memcpy(host_stage, p, alloc_bytes);
+                }
+                /* tiny compute kernel writing the buffer (like a dispatch op) */
+                int *ip = (int *) p;
+                size_t n = alloc_bytes / sizeof(int);
+                q.parallel_for(sycl::range<1>(n),
+                               [=](sycl::id<1> i) { ip[i] = (int) (i[0] + it); });
+            }
+            /* scalar D2H reads: the "recv_count.item()" that first sees a wedge */
+            for (long d = 0; d < d2h_iters && !batch.empty(); ++d) {
+                int scalar = 0;
+                q.memcpy(&scalar, batch[d % batch.size()], sizeof(int)).wait();
+                (void) scalar;
+            }
+            q.wait_and_throw();
+            if (spin_buf) { q2.wait_and_throw(); sycl::free(spin_buf, q2); spin_buf = nullptr; }
+        } catch (sycl::exception const &e) {
+            size_t freem = query_free_mem(dev);
+            std::fprintf(stderr,
+                "\n[pe=%d] *** COPY/COMPUTE EXC at iter=%ld ***\n"
+                "        exc: %s\n        FREE=%.3f GiB / TOTAL=%.3f GiB  "
+                "IBGDA doorbell_writes=%llu\n",
+                my_pe, it, e.what(), freem / (1024.0 * 1024.0 * 1024.0),
+                total_mem / (1024.0 * 1024.0 * 1024.0),
+                (unsigned long long) (dctx ? dctx->stats_doorbell_writes : 0));
+            std::fflush(stderr);
+            for (void *p : batch) if (p) sycl::free(p, q);
+            exit_code = is_oom_exception(e) ? 39 : 2;
+            reproduced = true;
+            break;
+        }
+
+        prev_batch = batch;
+
+        if (heartbeat > 0 && (it % heartbeat) == 0) {
+            std::fprintf(stderr,
+                "[pe=%d] iter=%ld OK  free=%.3f GiB  db_writes=%llu\n",
+                my_pe, it, query_free_mem(dev) / (1024.0 * 1024.0 * 1024.0),
+                (unsigned long long) (dctx ? dctx->stats_doorbell_writes : 0));
+            std::fflush(stderr);
+        }
+    }
+
+    for (void *p : prev_batch) if (p) sycl::free(p, q);
+    sycl::free(host_stage, q);
+
+    if (reproduced) {
+        std::fprintf(stderr,
+            "[pe=%d] RESULT: REPRODUCED device error (exit=%d) — see above.\n",
+            my_pe, exit_code);
+    } else {
+        std::fprintf(stderr,
+            "[pe=%d] RESULT: completed %ld iters with NO OOM (did not reproduce). "
+            "free=%.3f GiB\n",
+            my_pe, iters, query_free_mem(dev) / (1024.0 * 1024.0 * 1024.0));
+    }
+    std::fprintf(stderr, "[pe=%d] DONE (no ishmem_finalize)\n", my_pe);
+    std::fflush(stderr);
+    return exit_code;
+}
diff --git a/test/unit/oom_probe_wrapper.sh b/test/unit/oom_probe_wrapper.sh
new file mode 100755
index 00000000..64f49f9d
--- /dev/null
+++ b/test/unit/oom_probe_wrapper.sh
@@ -0,0 +1,40 @@
+#!/bin/bash
+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: BSD-3-Clause
+#
+# Per-rank wrapper for oom_copy_engine_probe, run inside the deepep-ll-v2
+# 2-node docker sim (node0: GPUs 0,1 + mlx5_0,1 ; node1: GPUs 2,3 + mlx5_2,3).
+# Pins each MPI rank to a SINGLE GPU + its same-PCIe-switch NIC, mirroring the
+# DeepEP LL per-rank layout that reproduces the OOM.
+set -uo pipefail
+
+# SIM_NODE_RANK (0 or 1) is written to /run/deepep_node_env by the container
+# PID1 (docker-compose per-node `environment:`), because mpirun's SSH-launched
+# ranks do NOT inherit the compose env.
+if [ -f /run/deepep_node_env ]; then
+    set +u; source /run/deepep_node_env; set -u
+fi
+NODE_RANK=${SIM_NODE_RANK:-0}
+LOCAL_RANK=${MPI_LOCALRANKID:-0}
+
+# Absolute GPU index + matching NIC on THIS 4-GPU host.
+GPU=$(( NODE_RANK * 2 + LOCAL_RANK ))
+export ZE_AFFINITY_MASK=$GPU
+export ISHMEM_IBGDA_NIC=mlx5_${GPU}
+export ZE_ENABLE_PCI_ID_DEVICE_ORDER=1
+export ZES_ENABLE_SYSMAN=1          # enable free-VRAM query in the probe
+
+# In-image oneAPI (2025.3) only.
+if [ -f /opt/intel/oneapi/setvars.sh ]; then
+    set +u; source /opt/intel/oneapi/setvars.sh --force >/dev/null 2>&1; set -u
+fi
+
+export ISHMEM_DIR=${ISHMEM_DIR:-/root/jiafuzha/code-repo/ishmem_ibgda/build/_install}
+export LD_LIBRARY_PATH=${ISHMEM_DIR}/lib:${LD_LIBRARY_PATH:-}
+if [ -f /usr/lib/x86_64-linux-gnu/libhwloc.so ]; then
+    export LD_PRELOAD="/usr/lib/x86_64-linux-gnu/libhwloc.so${LD_PRELOAD:+ $LD_PRELOAD}"
+fi
+
+echo "[$(hostname) node_rank=$NODE_RANK lr=$LOCAL_RANK] ZE_AFFINITY_MASK=$ZE_AFFINITY_MASK NIC=$ISHMEM_IBGDA_NIC" >&2
+ulimit -c unlimited
+exec "$@"

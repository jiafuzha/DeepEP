+#!/bin/bash
+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: BSD-3-Clause
+#
+# Single-host faithful GPU-direct-doorbell reproducer for THIS 4-GPU box
+# (GPUs 0..3 = 0000:1f/23/42/46, NICs mlx5_0..3 = 0000:25:00.0/.1, 48:00.0/.1).
+# Same per-rank GPU/NIC pairing as tests/docker-2node-ll-v2 but in one host.
+#
+#   rank 0 -> GPU 0 (0000:1f:00.0) + mlx5_0 (0000:25:00.0)   [RC 0x1c]
+#   rank 1 -> GPU 1 (0000:23:00.0) + mlx5_1 (0000:25:00.1)   [RC 0x1c]
+#   rank 2 -> GPU 2 (0000:42:00.0) + mlx5_2 (0000:48:00.0)   [RC 0x3f]
+#   rank 3 -> GPU 3 (0000:46:00.0) + mlx5_3 (0000:48:00.1)   [RC 0x3f]
+#
+# Pass criteria per PE (from ibgda_doorbell_proof.cpp):
+#   - flags=0x3f (direct-doorbell path armed)
+#   - doorbells_delta >= N_PUTS (GPU actually issued doorbells)
+#   - data errors == 0
+#
+# Env overridable: NPES (default 4), DB_MODE, QPS_PER_PE, ISHMEM_DEBUG.
+
+set -e
+SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
+ISHMEM_BUILD=${ISHMEM_BUILD:-$SELF_DIR/../../build2026}
+BIN=$ISHMEM_BUILD/test/unit/ibgda_doorbell_proof
+
+if [ ! -x "$BIN" ]; then
+    echo "ERROR: $BIN not found.  Build first:"
+    echo "  cd $SELF_DIR/../..; cmake --build build2026 --target ibgda_doorbell_proof -j"
+    exit 2
+fi
+
+source /opt/intel/oneapi/setvars.sh --force >/dev/null 2>&1
+
+NPES=${NPES:-4}
+
+cat > /tmp/ibgda_proof_wrapper_g0.sh <<'WRAP'
+#!/bin/bash
+LR=${MPI_LOCALRANKID:-0}
+case "$LR" in
+    0) export ZE_AFFINITY_MASK=0 ; export ISHMEM_IBGDA_NIC=mlx5_0 ;;
+    1) export ZE_AFFINITY_MASK=1 ; export ISHMEM_IBGDA_NIC=mlx5_1 ;;
+    2) export ZE_AFFINITY_MASK=2 ; export ISHMEM_IBGDA_NIC=mlx5_2 ;;
+    3) export ZE_AFFINITY_MASK=3 ; export ISHMEM_IBGDA_NIC=mlx5_3 ;;
+esac
+export ZE_ENABLE_PCI_ID_DEVICE_ORDER=1
+echo "[lr=$LR] ZE_AFFINITY_MASK=$ZE_AFFINITY_MASK ISHMEM_IBGDA_NIC=$ISHMEM_IBGDA_NIC" >&2
+exec "$@"
+WRAP
+chmod +x /tmp/ibgda_proof_wrapper_g0.sh
+
+ISHMEM_DEBUG=${ISHMEM_DEBUG:-0}
+DB_MODE=${DB_MODE:-0}
+QPS_PER_PE=${QPS_PER_PE:-1}
+
+set -x
+timeout 120 mpiexec.hydra -n "$NPES" \
+    -genv ISHMEM_IB_ENABLE_IBGDA 1 \
+    -genv ISHMEM_IBGDA_DIRECT_DOORBELL 1 \
+    -genv ISHMEM_IBGDA_DB_MODE "$DB_MODE" \
+    -genv ISHMEM_ENABLE_GPU_IPC 0 \
+    -genv ISHMEM_ENABLE_ACCESSIBLE_HOST_HEAP 0 \
+    -genv ISHMEM_SYMMETRIC_SIZE 67108864 \
+    -genv ISHMEM_IBGDA_QPS_PER_PE "$QPS_PER_PE" \
+    -genv ISHMEM_IBGDA_DB_BATCH_SIZE 0 \
+    -genv ISHMEM_IBGDA_BAR_BACKEND igub \
+    -genv ISHMEM_DEBUG "$ISHMEM_DEBUG" \
+    -genv I_MPI_FABRICS shm \
+    -genv FI_PROVIDER tcp \
+    /tmp/ibgda_proof_wrapper_g0.sh \
+    "$BIN"

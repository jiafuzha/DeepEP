new file mode 100755
index 00000000..365f61e1
--- /dev/null
+++ b/test/unit/run_oom_copy_engine_probe.sh
@@ -0,0 +1,180 @@
+#!/bin/bash
+# Copyright (C) 2026 Intel Corporation
+# SPDX-License-Identifier: BSD-3-Clause
+#
+# run_oom_copy_engine_probe.sh
+#
+# Build + run the STANDALONE iSHMEM-only reproducer oom_copy_engine_probe across
+# the deepep-ll-v2 2-node docker sim (the SAME containers / GPUs / NICs that
+# reproduce the residual DeepEP-LL mid-test UR_RESULT_ERROR_OUT_OF_DEVICE_MEMORY,
+# err 39). No DeepEP, no torch, no python -- just iSHMEM + IBGDA + igub.
+#
+#   node0 (deepep-ll-v2-node0): GPUs 0,1 + mlx5_0,1
+#   node1 (deepep-ll-v2-node1): GPUs 2,3 + mlx5_2,3
+#   -> 2 nodes x 2 ranks = 4 PEs, each pinned 1 GPU + its NIC (2-PE also works
+#      via NRANKS=2 PPN=1).
+#
+# Usage:
+#   ./run_oom_copy_engine_probe.sh                 # build + 1 run (4 PEs)
+#   LOOPS=10 ./run_oom_copy_engine_probe.sh        # 10 warm back-to-back runs
+#   ITERS=200 NUM_ALLOCS=48 DO_DOORBELL=0 ./run_oom_copy_engine_probe.sh
+#   NOBUILD=1 ./run_oom_copy_engine_probe.sh       # skip the in-container build
+#
+# Env knobs forwarded to the probe (see oom_copy_engine_probe.cpp):
+#   ITERS NUM_ALLOCS ALLOC_BYTES PUTS_PER_ITER DO_DOORBELL COPY_PRESSURE
+#   D2H_ITERS STOP_ON_OOM HEARTBEAT
+set -uo pipefail
+
+SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ISHMEM_REPO="$(cd "$SELF_DIR/../.." && pwd)"                 # .../ishmem_ibgda
+LL_DIR="/root/jiafuzha/code-repo/zjf2012/DeepEP/tests/docker-2node-ll-v2"
+NODE0="deepep-ll-v2-node0"
+NODE1="deepep-ll-v2-node1"
+BIN="$ISHMEM_REPO/build/test/unit/oom_copy_engine_probe"
+WRAP="$ISHMEM_REPO/test/unit/oom_probe_wrapper.sh"
+ISHMEM_DIR="${ISHMEM_DIR:-$ISHMEM_REPO/build/_install}"
+
+NRANKS="${NRANKS:-4}"
+PPN="${PPN:-2}"
+TIMEOUT_SEC="${TIMEOUT_SEC:-180}"
+LOOPS="${LOOPS:-1}"
+
+# --- probe knobs (defaults chosen to mimic the LL dispatch shape) ---
+export ITERS="${ITERS:-80}"
+export NUM_ALLOCS="${NUM_ALLOCS:-32}"
+export ALLOC_BYTES="${ALLOC_BYTES:-262144}"
+export PUTS_PER_ITER="${PUTS_PER_ITER:-64}"
+export DO_DOORBELL="${DO_DOORBELL:-1}"
+export COPY_PRESSURE="${COPY_PRESSURE:-1}"
+export D2H_ITERS="${D2H_ITERS:-8}"
+export STOP_ON_OOM="${STOP_ON_OOM:-1}"
+export HEARTBEAT="${HEARTBEAT:-10}"
+export OVERLAP_KERNEL="${OVERLAP_KERNEL:-0}"
+export OVERLAP_SPIN="${OVERLAP_SPIN:-2000000}"
+ISHMEM_DEBUG="${ISHMEM_DEBUG:-0}"
+
+# --- ensure containers are up (reuse the DeepEP LL harness compose) ---
+ensure_up() {
+    if docker ps --format '{{.Names}}' | grep -q "$NODE0" \
+       && docker ps --format '{{.Names}}' | grep -q "$NODE1"; then
+        install_ssh_config
+        return 0
+    fi
+    echo "===== bringing up deepep-ll-v2 containers via DeepEP LL compose ====="
+    ( cd "$LL_DIR" && ISHMEM_DIR="$ISHMEM_DIR" docker compose up -d ) 2>&1 | tail -3
+    sleep 5
+    install_ssh_config
+    for i in 1 2 3 4 5; do
+        if docker exec "$NODE0" ssh -o StrictHostKeyChecking=no -o BatchMode=yes \
+              -o UserKnownHostsFile=/dev/null -i /root/.ssh/id_rsa "$NODE1" true 2>/dev/null; then
+            echo "Containers ready."
+            return 0
+        fi
+        sleep 2
+    done
+    echo "WARNING: node0->node1 SSH not confirmed ready (continuing)"
+}
+
+# The shared /tmp/deepep-docker-ssh dir may hold a config from the *normal* sim
+# (deepep-v2, ports 2320/2321). Regenerate it for THIS sim (ports 2330/2331) and
+# push it into the running containers (they only copy it at container start).
+install_ssh_config() {
+    local dir=/tmp/deepep-docker-ssh
+    mkdir -p "$dir"
+    [ -f "$dir/id_rsa" ] || ssh-keygen -t rsa -N "" -f "$dir/id_rsa" -q
+    cat > "$dir/config" <<EOF
+Host $NODE0
+    HostName 127.0.0.1
+    Port 2330
+    User root
+    IdentityFile /root/.ssh/id_rsa
+    StrictHostKeyChecking no
+    UserKnownHostsFile /dev/null
+Host $NODE1
+    HostName 127.0.0.1
+    Port 2331
+    User root
+    IdentityFile /root/.ssh/id_rsa
+    StrictHostKeyChecking no
+    UserKnownHostsFile /dev/null
+EOF
+    for c in "$NODE0" "$NODE1"; do
+        docker exec "$c" cp /tmp/ssh-keys/config /root/.ssh/config 2>/dev/null || true
+    done
+}
+
+build_probe() {
+    [ "${NOBUILD:-0}" = "1" ] && { echo "NOBUILD=1: skip build"; return 0; }
+    echo "===== building oom_copy_engine_probe inside $NODE0 (oneAPI 2025.3) ====="
+    docker exec "$NODE0" bash -lc "
+        set -e
+        source /opt/intel/oneapi/setvars.sh --force >/dev/null 2>&1
+        cd $ISHMEM_REPO/build
+        cmake .. -DBUILD_UNIT_TESTS=ON >/tmp/oom_probe_cmake.log 2>&1
+        cmake --build . --target oom_copy_engine_probe -j\$(nproc) 2>&1 | tail -15
+        test -x $BIN && echo 'BUILD_OK' || { echo 'BUILD_FAILED'; tail -30 /tmp/oom_probe_cmake.log; exit 3; }
+    "
+}
+
+run_once() {
+    local tag="$1"
+    docker exec "$NODE0" chmod +x "$WRAP" 2>/dev/null || true
+    set +e
+    docker exec \
+        -e ITERS="$ITERS" -e NUM_ALLOCS="$NUM_ALLOCS" -e ALLOC_BYTES="$ALLOC_BYTES" \
+        -e PUTS_PER_ITER="$PUTS_PER_ITER" -e DO_DOORBELL="$DO_DOORBELL" \
+        -e COPY_PRESSURE="$COPY_PRESSURE" -e D2H_ITERS="$D2H_ITERS" \
+        -e STOP_ON_OOM="$STOP_ON_OOM" -e HEARTBEAT="$HEARTBEAT" \
+        -e ISHMEM_DEBUG="$ISHMEM_DEBUG" \
+        "$NODE0" bash -lc "
+            source /opt/intel/oneapi/setvars.sh --force >/dev/null 2>&1
+            export ISHMEM_DIR=$ISHMEM_DIR
+            export LD_LIBRARY_PATH=\$ISHMEM_DIR/lib:\${LD_LIBRARY_PATH:-}
+            timeout $TIMEOUT_SEC mpirun \
+                -n $NRANKS -ppn $PPN \
+                -hosts $NODE0,$NODE1 \
+                -genv ISHMEM_IB_ENABLE_IBGDA 1 \
+                -genv ISHMEM_IBGDA_DIRECT_DOORBELL 1 \
+                -genv ISHMEM_ENABLE_GPU_IPC 0 \
+                -genv ISHMEM_ENABLE_ACCESSIBLE_HOST_HEAP 0 \
+                -genv ISHMEM_SYMMETRIC_SIZE 268435456 \
+                -genv ZE_ENABLE_PCI_ID_DEVICE_ORDER 1 \
+                -genv ISHMEM_IBGDA_QPS_PER_PE 1 \
+                -genv ISHMEM_IBGDA_DB_BATCH_SIZE 0 \
+                -genv ISHMEM_IBGDA_BAR_BACKEND igub \
+                -genv I_MPI_FABRICS shm:ofi \
+                -genv FI_PROVIDER tcp \
+                -genv ISHMEM_DIR $ISHMEM_DIR \
+                -genv ISHMEM_DEBUG $ISHMEM_DEBUG \
+                -genv ITERS $ITERS -genv NUM_ALLOCS $NUM_ALLOCS \
+                -genv ALLOC_BYTES $ALLOC_BYTES -genv PUTS_PER_ITER $PUTS_PER_ITER \
+                -genv DO_DOORBELL $DO_DOORBELL -genv COPY_PRESSURE $COPY_PRESSURE \
+                -genv D2H_ITERS $D2H_ITERS -genv STOP_ON_OOM $STOP_ON_OOM \
+                -genv HEARTBEAT $HEARTBEAT -genv OVERLAP_KERNEL $OVERLAP_KERNEL -genv OVERLAP_SPIN $OVERLAP_SPIN -genv ZES_ENABLE_SYSMAN 1 \
+                -launcher ssh \
+                -bootstrap-exec-args '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i /root/.ssh/id_rsa' \
+                $WRAP $BIN
+        "
+    local rc=$?
+    set -e
+    echo "===== $tag rc=$rc ====="
+    return $rc
+}
+
+ensure_up
+build_probe
+
+rm -f /dev/shm/sem.psm3* /dev/shm/psm3_* /dev/shm/sem.ishmem* /dev/shm/*ishmem* /tmp/deep_ep_xpu_ipc_*.sock 2>/dev/null || true
+
+pass=0; oom=0; other=0
+for l in $(seq 1 "$LOOPS"); do
+    run_once "LOOP $l/$LOOPS"
+    rc=$?
+    if   [ $rc -eq 0  ]; then pass=$((pass+1))
+    elif [ $rc -eq 39 ]; then oom=$((oom+1))
+    else other=$((other+1)); fi
+    sleep 2
+done
+echo ""
+echo "===== SUMMARY: $LOOPS runs -> no-repro(pass)=$pass  OOM(39)=$oom  other=$other ====="
+[ $oom -gt 0 ] && exit 39 || exit 0
-- 

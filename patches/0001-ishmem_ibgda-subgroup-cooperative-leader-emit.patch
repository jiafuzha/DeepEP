+ISHMEM_DEVICE_ATTRIBUTES void ishmemx_putmem_nbi_sub_group(void *dest, const void *src, size_t nbytes, int pe, bool active, unsigned int affinity_id, const sycl::sub_group &grp);
+
 /* get_nbi_on_queue */
 template <typename T> sycl::event ishmemx_get_nbi_on_queue(T *, const T *, size_t, int, sycl::queue &, const std::vector<sycl::event> & = {});
